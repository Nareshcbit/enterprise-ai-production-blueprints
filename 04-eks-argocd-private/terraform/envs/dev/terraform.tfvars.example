# Copy to terraform.tfvars (gitignored) and fill in the <...> values.

region = "us-east-1"
name   = "argocd-private-dev"

vpc_cidr        = "10.30.0.0/16"
azs             = ["us-east-1a", "us-east-1b"]
public_subnets  = ["10.30.101.0/24", "10.30.102.0/24"]
private_subnets = ["10.30.1.0/24", "10.30.2.0/24"]

tags = {
  Environment = "dev"
  Project     = "eks-argocd-private"
}

# Latest standard-support version, checked 2026-10-18.
kubernetes_version = "1.37"

# Your workstation's public IPv4 as a /32 (`curl -4 ifconfig.me`), for kubectl.
# The Argo CD endpoint itself is never public.
public_access_cidrs = ["<your-ipv4>/32"]

# Who can use the cluster (console and kubectl). access: admin or view.
# Must include the identity that runs terraform (see `aws sts get-caller-identity`).
eks_access_entries = {
  me = {
    principal_arn = "arn:aws:iam::<ACCOUNT_ID>:role/<your-admin-role>"
    access        = "admin"
  }
}

# `aws sso-admin list-instances` gives the instance ARN.
idc_instance_arn = "arn:aws:sso:::instance/ssoins-<id>"
idc_region       = "us-east-1"

# `aws identitystore list-users` / `list-groups` give the ID. Prefer a group.
argocd_admin_identity = {
  id   = "<identity-center-user-or-group-id>"
  type = "SSO_GROUP"
}

# Where Argo CD may deploy on the hub; matches k8s/guestbook-*.yaml.
deploy_namespace = "guestbook"
